<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Buscar un alimento y registrar una porción -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.macrotrack.controller.RegistrarComidaController"
            prefWidth="420.0" prefHeight="720.0">

    <top>
        <HBox styleClass="encabezado" alignment="CENTER_LEFT" spacing="10">
            <Button text="←" styleClass="boton-encabezado" onAction="#volver"/>
            <VBox>
                <Label styleClass="titulo" text="Registrar comida"/>
                <Label styleClass="subtitulo" text="Busca un alimento y escribe los gramos"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>

            <!-- Búsqueda -->
            <TextField fx:id="txtBuscar" promptText="Buscar alimento (mín. 2 letras)..."/>
            <ListView fx:id="lstResultados" prefHeight="190" VBox.vgrow="ALWAYS"/>

            <!-- Alimento elegido -->
            <VBox styleClass="tarjeta" spacing="4">
                <Label fx:id="lblAlimento" styleClass="tarjeta-titulo" text="Ningún alimento seleccionado"/>
                <Label fx:id="lblPor100g" styleClass="texto-suave" text="Elige uno de la lista"/>
            </VBox>

            <!-- Datos de la porción -->
            <GridPane hgap="10" vgap="10">
                <Label text="Gramos" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtGramos" promptText="Ej. 150" onAction="#guardar" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Tipo de comida" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbTipo" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Fecha" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Vista previa de lo que se va a registrar -->
            <VBox styleClass="tarjeta" spacing="4">
                <Label text="Esta porción aporta" styleClass="texto-suave"/>
                <Label fx:id="lblVistaPrevia" styleClass="tarjeta-titulo" text="—"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="8">
            <padding><Insets top="0" right="16" bottom="16" left="16"/></padding>
            <Button text="Cancelar" styleClass="boton-secundario" onAction="#volver"/>
            <Button fx:id="btnGuardar" text="Guardar" styleClass="boton-primario" maxWidth="Infinity"
                    HBox.hgrow="ALWAYS" onAction="#guardar"/>
        </HBox>
    </bottom>
</BorderPane>
