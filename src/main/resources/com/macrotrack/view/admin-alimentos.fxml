<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Panel de administrador: catálogo de alimentos (solo ADMIN) -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.macrotrack.controller.AdminAlimentosController"
            prefWidth="780.0" prefHeight="600.0">

    <top>
        <HBox styleClass="encabezado" alignment="CENTER_LEFT" spacing="10">
            <Button text="←" styleClass="boton-encabezado" onAction="#volver"/>
            <VBox>
                <Label styleClass="titulo" text="Catálogo de alimentos"/>
                <Label styleClass="subtitulo" text="Panel de administrador · valores por cada 100 g"/>
            </VBox>
        </HBox>
    </top>

    <!-- Izquierda: búsqueda y tabla -->
    <center>
        <VBox spacing="10">
            <padding><Insets top="12" right="8" bottom="16" left="16"/></padding>
            <TextField fx:id="txtBuscar" promptText="Buscar alimento (mín. 2 letras)..."/>
            <TableView fx:id="tblAlimentos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="170"/>
                    <TableColumn fx:id="colKcal" text="kcal" prefWidth="60"/>
                    <TableColumn fx:id="colProteina" text="Prot." prefWidth="60"/>
                    <TableColumn fx:id="colCarbos" text="Carb." prefWidth="60"/>
                    <TableColumn fx:id="colGrasas" text="Grasa" prefWidth="60"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- Derecha: formulario -->
    <right>
        <VBox spacing="12" prefWidth="290">
            <padding><Insets top="12" right="16" bottom="16" left="8"/></padding>

            <VBox styleClass="tarjeta" spacing="10">
                <Label fx:id="lblModo" styleClass="tarjeta-titulo" text="Nuevo alimento"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="kcal" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtKcal" promptText="0 - 900" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Proteína (g)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtProteina" promptText="0 - 100" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Carbohidratos (g)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCarbos" promptText="0 - 100" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Grasas (g)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtGrasas" promptText="0 - 100" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <Label styleClass="texto-suave" wrapText="true"
                       text="Proteína + carbohidratos + grasas no puede pasar de 100 g."/>
            </VBox>

            <Button text="Guardar" styleClass="boton-primario" maxWidth="Infinity" onAction="#guardar"/>
            <HBox spacing="8">
                <Button text="Nuevo" styleClass="boton-secundario" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        onAction="#nuevo"/>
                <Button fx:id="btnBaja" text="Dar de baja" styleClass="boton-peligro" maxWidth="Infinity"
                        HBox.hgrow="ALWAYS" onAction="#darDeBaja"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
